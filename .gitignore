*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Machine-specific script configuration. See scripts/env.local.sh.example.
/scripts/env.local.sh

# Per-machine agent permissions. The shared .claude/settings.json is committed;
# this one accumulates absolute paths from whoever's machine it is. It is also
# covered by the usual global gitignore, which is exactly why it belongs here
# too — a contributor cloning this repo does not have that global rule.
.claude/settings.local.json

# Signing material. This repository is public: a leaked upload key cannot be
# rotated for an app already published, so these must never be committed.
*.jks
*.keystore
*.p12
keystore.properties
signing.properties

# Benchmark and profiling output. Large, machine-specific, regenerated.
/benchmark/build
*.trace
*.perfetto-trace

# Scratch folder for handoff bundles and other material that should not ship in
# a public repository.
/removeme/
