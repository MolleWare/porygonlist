<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a low-poly bird in the app's palette.

  Original artwork. The app's name nods at the polygon Pokémon; nothing here is
  traced from or copied out of a Nintendo asset, which matters because this
  repository is public.

  Construction, in case it ever needs editing by hand. The bird is two polygons
  — head and body — each filled as a fan of triangles from an interior vertex,
  which is what gives the faceted look. Every facet is a step of the cream ramp
  in `theme/Color.kt`, chosen by which way the facet would face a light source
  at the top left; the peach accent is spent only on the beak and the wing, so
  the silhouette stays one mass instead of reading as a head stacked on a body.

  The outline vertices, shared between the two fans:

      A(84,42) beak tip      B(62,34) beak upper root   C(56,24) crown
      D(28,40) crest         E(36,56) neck notch        T(26,70) tail
      G(46,79) belly         P(68,64) chest             I(64,48) throat

  Every one of them sits inside a circle of radius 33 around the centre, which
  is the region a round launcher mask is guaranteed to keep. Moving any vertex
  further out risks it being cropped on someone's phone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Body, fanned from (48,64). -->
    <path android:fillColor="#CDB5A4" android:pathData="M36,56 L26,70 L48,64 Z" />
    <path android:fillColor="#C0A493" android:pathData="M26,70 L46,79 L48,64 Z" />
    <path android:fillColor="#DECEC2" android:pathData="M46,79 L68,64 L48,64 Z" />
    <path android:fillColor="#F0E6DE" android:pathData="M68,64 L64,48 L48,64 Z" />
    <path android:fillColor="#F7EAE0" android:pathData="M64,48 L36,56 L48,64 Z" />

    <!-- Head, fanned from (54,42). -->
    <path android:fillColor="#F7EAE0" android:pathData="M62,34 L56,24 L54,42 Z" />
    <path android:fillColor="#FFFFFF" android:pathData="M56,24 L28,40 L54,42 Z" />
    <path android:fillColor="#DECEC2" android:pathData="M28,40 L36,56 L54,42 Z" />
    <path android:fillColor="#F0E6DE" android:pathData="M36,56 L64,48 L54,42 Z" />
    <path android:fillColor="#FAF4F0" android:pathData="M64,48 L62,34 L54,42 Z" />

    <!-- Folded wing, swept back towards the tail. -->
    <path android:fillColor="#EB9E79" android:pathData="M58,52 L32,70 L56,66 Z" />
    <path android:fillColor="#FFC0A0" android:pathData="M58,52 L32,70 L48,60 Z" />

    <!-- Beak. The one long protrusion, and what makes it read as a bird at 48px. -->
    <path android:fillColor="#F9D2BA" android:pathData="M84,42 L62,34 L64,48 Z" />
    <path android:fillColor="#EB9E79" android:pathData="M84,42 L64,48 L68,44 Z" />

    <!-- Eye, in the background's green so the two layers share a colour. -->
    <path android:fillColor="#1D4533" android:pathData="M60,34 L65,39 L60,44 L55,39 Z" />
</vector>
