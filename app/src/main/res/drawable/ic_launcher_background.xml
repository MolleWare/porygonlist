<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: the palette's deep green, split on the diagonal.

  The split is the same lighting the bird in the foreground is lit by — top left
  bright, bottom right in shade — so the two layers read as one object rather
  than a sticker on a square. It is a hard edge rather than a gradient because
  the whole icon is made of flat facets.

  Adaptive icons are 108dp with only the middle 72dp guaranteed visible, so a
  background must cover the full canvas and carry nothing that matters.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#1D4533" android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
    <path android:fillColor="#17392B" android:pathData="M0,108 L108,0 L108,108 Z" />
</vector>
