<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Lets the app tell which link it is on, so peer discovery can be held on networks the owner
      has not opted into. Normal protection level: granted at install, no runtime prompt.

      Nothing about identifying a network depends on this: that is ACCESS_NETWORK_STATE and the
      fingerprint below it.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Optional, and only ever for a name.

      Android will not hand over the SSID of the network you are on without it, so without this the
      Share screen can only call your wifi "Network a3f91c" — true, and useless for telling two of
      them apart. Granting it puts the real name there instead.

      What it deliberately does NOT do is decide anything. An SSID is free to claim: a phone in a
      car park can advertise "Home". So discovery still matches on the permission-free fingerprint,
      and the trust that matters is still the pinned key. Decline this and the app behaves exactly
      as it did before it existed — see WifiName and docs/ARCHITECTURE.md.

      maxSdkVersion is not set and must not be: the requirement runs to current Android.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PorygonList">
        <!--
          windowSoftInputMode belongs on the activity, not the application — it was being ignored
          where it was. The keyboard does not resize the window here anyway, because the app draws
          edge to edge; it arrives as an inset and the layout decides what moves. See MainNavigation.
        -->
        <!--
          singleTop because of the pairing link below: with the default launch mode, opening one
          while the app is already running builds a second copy of the activity on top of the first.
          singleTop delivers it to onNewIntent instead.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Pairing links: porygonlist://pair?c=PLPAIR1…

              This is what stands in for a camera in the app. The invite's QR code carries one of
              these, so the *other* phone's ordinary camera app can read it and offer to open it
              here — no CAMERA permission, no camera library, nothing to ship. The same link in a
              message is tappable, which the bare code never was.

              BROWSABLE means anything on the phone can send us one of these, so opening a link
              must never be an act of trust. It carries the code to the pairing screen and stops in
              front of the same question a pasted code faces. See PairingCodec.link.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="porygonlist" android:host="pair" />
            </intent-filter>
        </activity>
    </application>

</manifest>
