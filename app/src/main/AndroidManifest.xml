<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Lets the app tell which link it is on, so peer discovery can be held on networks the owner
      has not opted into. Normal protection level: granted at install, no runtime prompt.

      Nothing about identifying a network depends on this: that is ACCESS_NETWORK_STATE and the
      fingerprint below it.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Opening and accepting sockets. Normal protection level: granted at install, no runtime
      prompt, and it is the permission Android requires for any socket at all — there is no
      narrower one meaning "the local network only".

      So the name overstates what this app does with it, and the limit has to come from the code
      rather than from the manifest. Nothing here ever addresses anything off the link: peers are
      found by mDNS on the local subnet, the address connected to is one the responder gave, and
      the whole of it is held shut unless discoveryDecision says the owner approved this network.
      There is no server, no account and no relay — see docs/ARCHITECTURE.md.

      NsdManager itself needs nothing: the responder runs in the system process, which is also why
      no multicast lock is taken here.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Optional, and only ever for a name.

      Android will not hand over the SSID of the network you are on without it, so without this the
      Share screen can only call your wifi "Network a3f91c" — true, and useless for telling two of
      them apart. Granting it puts the real name there instead.

      What it deliberately does NOT do is decide anything. An SSID is free to claim: a phone in a
      car park can advertise "Home". So discovery still matches on the permission-free fingerprint,
      and the trust that matters is still the pinned key. Decline this and the app behaves exactly
      as it did before it existed — see WifiName and docs/ARCHITECTURE.md.

      maxSdkVersion is not set and must not be: the requirement runs to current Android.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Lets the background sync window (SyncJob) stay scheduled across a reboot. Normal protection
      level: granted at install, no runtime prompt. The app is not started at boot by this; the job
      scheduler simply remembers the job, and it runs on its usual quarter-hour schedule.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Optional: wakes the background window on the exact quarter hour even in Doze, so every paired
      phone listens at the same moment. See BackgroundSync.

      Android 14 and later leave it off until the owner turns on "Alarms & reminders" for the app;
      Settings offers the way there. Without it the job scheduler aims at the same quarter hours, but
      Doze can hold a window back past them.
      Not USE_EXACT_ALARM: that one is granted silently, and is meant for alarm clocks.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Holding the quarter-hour window open as a foreground service, which is what keeps the network
      through Doze for its thirty seconds. Normal protection level. The service is a short service,
      which needs no type-specific permission beside this one. See SyncWindowService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      No backup and no device-to-device transfer, by decision: lists are throwaway, and a restored
      state file belongs to an identity the new phone does not hold. See data_extraction_rules.xml.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PorygonList">
        <!--
          windowSoftInputMode belongs on the activity, not the application — it was being ignored
          where it was. The keyboard does not resize the window here anyway, because the app draws
          edge to edge; it arrives as an inset and the layout decides what moves. See MainNavigation.
        -->
        <!--
          singleTop because of the pairing link below: with the default launch mode, opening one
          while the app is already running builds a second copy of the activity on top of the first.
          singleTop delivers it to onNewIntent instead.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Pairing links: porygonlist://pair?c=PLPAIR1…

              This is what stands in for a camera in the app. The invite's QR code carries one of
              these, so the *other* phone's ordinary camera app can read it and offer to open it
              here — no CAMERA permission, no camera library, nothing to ship. The same link in a
              message is tappable, which the bare code never was.

              BROWSABLE means anything on the phone can send us one of these, so opening a link
              must never be an act of trust. It carries the code to the pairing screen and stops in
              front of the same question a pasted code faces. See PairingCodec.link.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="porygonlist" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
          A short sync window every quarter-hour or so while the app is out of sight. Not exported:
          only the system's job scheduler, which holds BIND_JOB_SERVICE, may start it. See SyncJob.
        -->
        <service
            android:name=".data.net.SyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          The same window on the exact quarter hour, started by SyncAlarm when the alarm fires. Not
          exported. See SyncWindowService.
        -->
        <service
            android:name=".data.net.SyncWindowService"
            android:exported="false"
            android:foregroundServiceType="shortService"
            tools:targetApi="34" />

        <!--
          The quarter-hour alarm, and the owner granting exact alarms from Settings. Not exported:
          the alarm comes through the app's own PendingIntent, and the grant from the system.
        -->
        <receiver
            android:name=".data.net.SyncAlarm"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Told when a wifi is joined (through a PendingIntent the app registers with
          ConnectivityManager) and after a reboot, so the sync windows run only on approved wifi.
          Not exported: both senders are the system. See WifiWatch.
        -->
        <receiver
            android:name=".data.net.WifiWatch"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
