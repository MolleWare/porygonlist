# Release signing. Copy to keystore.properties (git-ignored) and fill in.
#
# One key signs every store's build: F-Droid publishes our signed APK through reproducible builds,
# and Play App Signing is enrolled with this same key ("use my own key"). So an install from either
# store can be updated from the other. Lose the key and the app can never be updated again — keep a
# backup somewhere that is not this machine. Never commit the key or this file's filled-in copy.
#
# To make one (once, by hand):
#   keytool -genkeypair -v -keystore porygonlist-release.jks -alias porygonlist \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Paths are relative to the repository root.

storeFile=porygonlist-release.jks
storePassword=
keyAlias=porygonlist
keyPassword=
