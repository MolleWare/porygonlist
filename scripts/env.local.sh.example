#!/usr/bin/env bash
# Copy to scripts/env.local.sh and adjust for your machine.
#
# scripts/env.local.sh is gitignored on purpose. Paths here are specific to
# your setup and, on a public repository, are nobody else's business.

# A JDK 21 installation. Newer JDKs are not supported by the Android Gradle
# Plugin, so point this at 21 even if your system default is something else.
#   Fedora:  /usr/lib/jvm/java-21-openjdk  or  /usr/lib/jvm/java-21-temurin-jdk
#   Debian:  /usr/lib/jvm/java-21-openjdk-amd64
#   macOS:   $(/usr/libexec/java_home -v 21)
export JAVA_HOME=/path/to/jdk-21

# Android SDK root, the directory containing platform-tools/ and platforms/.
#   Linux:  $HOME/Android/Sdk
#   macOS:  $HOME/Library/Android/sdk
export ANDROID_HOME="$HOME/Android/Sdk"
